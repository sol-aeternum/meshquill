@final
class DiscoveredDevice:
    @property
    def id(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def transport(self) -> Literal["ble", "serial", "tcp", "scripted", "unknown"]: ...
    @property
    def address(self) -> str | None: ...
    @property
    def port(self) -> int | None: ...
    @property
    def baud(self) -> int | None: ...
