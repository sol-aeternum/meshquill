@final
class EventStream(AsyncIterator[Event]):
    def __aiter__(self) -> EventStream: ...
    def __anext__(self) -> Awaitable[Event]: ...

@final
class MessageStream(AsyncIterator[Message]):
    def __aiter__(self) -> MessageStream: ...
    def __anext__(self) -> Awaitable[Message]: ...

@final
class Client:
    @classmethod
    def auto(
        cls,
        *,
        profile: str | None = ...,
        config_path: str | PathLike[str] | None = ...,
    ) -> Awaitable[Client]: ...
    @classmethod
    def tcp(
        cls,
        host: str,
        port: int = ...,
        *,
        connect_timeout: float = ...,
        request_timeout: float = ...,
    ) -> Awaitable[Client]: ...
    @classmethod
    def serial(
        cls,
        port: str,
        *,
        baud: int = ...,
        connect_timeout: float = ...,
        request_timeout: float = ...,
    ) -> Awaitable[Client]: ...
    @classmethod
    def ble(
        cls,
        selector: str,
        *,
        connect_timeout: float = ...,
        request_timeout: float = ...,
    ) -> Awaitable[Client]: ...
    @classmethod
    def demo(cls, *, request_timeout: float = ...) -> Awaitable[Client]: ...
    @property
    def transport(self) -> Literal["ble", "serial", "tcp", "demo"]: ...
    @property
    def profile_name(self) -> str | None: ...
    @property
    def request_timeout(self) -> float: ...
    @property
    def is_closed(self) -> bool: ...
    @property
    def self_info(self) -> SelfInfo: ...
    def events(self) -> EventStream: ...
    def messages(self) -> MessageStream: ...
    def list_contacts(self, last_modified: int | None = ...) -> Awaitable[list[Contact]]: ...
    def send(self, contact: str, text: str, *, attempt: int = ...) -> Awaitable[SendReceipt]: ...
    def send_direct(
        self, destination: str | bytes, text: str, *, attempt: int = ...
    ) -> Awaitable[SendReceipt]: ...
    def send_command(
        self, destination: str | bytes, command: str, *, attempt: int = ...
    ) -> Awaitable[SendReceipt]: ...
    def send_channel(self, channel: int, text: str, *, text_type: int = ...) -> Awaitable[None]: ...
    def fetch_queued_message(self) -> Awaitable[Message | None]: ...
    def wait_for_ack(
        self,
        receipt_or_code: SendReceipt | str | bytes,
        *,
        timeout: float | None = ...,
    ) -> Awaitable[Ack]: ...
    def device_info(self) -> Awaitable[DeviceInfo]: ...
    def disconnect(self) -> Awaitable[None]: ...
    def reconnect(self) -> Awaitable[SelfInfo]: ...
    def shutdown(self) -> Awaitable[None]: ...
    def telemetry(
        self, kind: Literal["core", "radio", "packets"] = ...
    ) -> Awaitable[DeviceStats]: ...
    def self_telemetry(self) -> Awaitable[TelemetryResponse]: ...
    def __aenter__(self) -> Awaitable[Client]: ...
    def __aexit__(
        self,
        exception_type: type[BaseException] | None,
        exception: BaseException | None,
        traceback: TracebackType | None,
    ) -> Awaitable[None]: ...

def discover_ble(*, timeout: float = ...) -> Awaitable[list[DiscoveredDevice]]: ...
def discover_serial() -> Awaitable[list[DiscoveredDevice]]: ...
